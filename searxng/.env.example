# SearXNG Configuration
SEARXNG_IMAGE=docker.io/searxng/searxng:latest
SEARXNG_REDIS_IMAGE=docker.io/valkey/valkey:alpine
SEARXNG_BIND_ADDRESS=127.0.0.1
SEARXNG_PORT=8888

# Hostname
SEARXNG_HOSTNAME=searxng.domain.com

# Security
SEARXNG_SECRET_KEY=CHANGE_ME_SEARXNG_SECRET_KEY
REDIS_PASSWORD=CHANGE_ME_SEARXNG_SECRET_KEY
REDIS_CONFIG_RENAME=SEARXNG_CONFIG

# Logging
SEARXNG_LOG_LEVEL=info
SEARXNG_DEBUG=false

# Search Settings
SEARXNG_THEME=simple
SEARXNG_DEFAULT_LOCALE=en
SEARXNG_SAFE_SEARCH=0
SEARXNG_MAX_REQUEST_TIMEOUT=10.0

# Instance Settings
SEARXNG_INSTANCE_NAME=SearXNG
SEARXNG_DISABLE_BRAND=false

# Network
SEARXNG_NETWORK_INTERNAL=false
