# Nextcloud Configuration
NEXTCLOUD_BIND_ADDRESS=127.0.0.1
NEXTCLOUD_PORT=5000

# Database Configuration
# openssl rand --hex 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_HOST=db

# Redis Configuration
# openssl rand --hex 32
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_CONFIG_RENAME=NEXTCLOUD_CONFIG

# Nextcloud App
NEXTCLOUD_TRUSTED_DOMAINS="nextcloud.domain.com localhost 127.0.0.1 192.168.0.100"
OVERWRITEHOST=nextcloud.domain.com
NEXTCLOUD_NETWORK_INTERNAL=false

# External Storage
# EXTERNAL_STORAGE_PATH=/path/to/external-storage
# EXTERNAL_STORAGE_MOUNT=/var/www/html/data/external/

# PHP Settings
PHP_UPLOAD_LIMIT=10G
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=3600
PHP_POST_MAX_SIZE=10G

# Images
NEXTCLOUD_DB_IMAGE=docker.io/mariadb:11.8-ubi9
NEXTCLOUD_REDIS_IMAGE=docker.io/redis:alpine
NEXTCLOUD_APP_IMAGE=docker.io/nextcloud:stable-fpm
NEXTCLOUD_WEB_IMAGE=docker.io/nginx:alpine

# Limits
DB_MEM_LIMIT=1g
DB_MEM_RESERVATION=256m
DB_MEMSWAP_LIMIT=1.2g
DB_CPUS=0.8
DB_PIDS_LIMIT=300

APP_MEM_LIMIT=1g
APP_MEM_RESERVATION=256m
APP_MEMSWAP_LIMIT=1.2g
APP_CPUS=1.0
APP_PIDS_LIMIT=500

WEB_MEM_LIMIT=256m
WEB_MEM_RESERVATION=64m
WEB_MEMSWAP_LIMIT=256m
WEB_CPUS=0.3
WEB_PIDS_LIMIT=100