# ============================================
# IMAGE VERSIONS
# ============================================
NEXTCLOUD_APP_IMAGE=docker.io/nextcloud:stable-fpm
NEXTCLOUD_DB_IMAGE=docker.io/mariadb:11.8-ubi9
NEXTCLOUD_REDIS_IMAGE=docker.io/redis:alpine
NEXTCLOUD_WEB_IMAGE=docker.io/nginx:alpine

# ============================================
# DATABASE
# ============================================
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_DATABASE=nextcloud_db
MYSQL_USER=nextcloud
MYSQL_HOST=db

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ============================================
# PHP CONFIGURATION
# ============================================
PHP_UPLOAD_LIMIT=10G
PHP_MEMORY_LIMIT=2G
PHP_MAX_EXECUTION_TIME=3600
PHP_POST_MAX_SIZE=10G

# ============================================
# NEXTCLOUD DOMAIN
# ============================================
NEXTCLOUD_TRUSTED_DOMAINS="your-domain.com localhost 127.0.0.1 192.168.1.100"
OVERWRITEHOST=your-domain.com

# ============================================
# EXTERNAL STORAGE
# ============================================
EXTERNAL_STORAGE_PATH=./external
EXTERNAL_STORAGE_MOUNT=/var/www/html/data/external/
