# ============================================
# IMAGE TAGS
# ============================================
# Change to a stable image (https://hub.docker.com/r/authentik/server)
AUTHENTIK_IMAGE=authentik/server:latest 
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:alpine

# ============================================
# AUTHENTIK CONFIGURATION
# ============================================
# Generate with: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=your_generated_secret_key_here
# Minimum 16 characters, use a password generator
AUTHENTIK_POSTGRES_PASSWORD=your_postgres_password_here
# Minimum 16 characters, use a password generator
AUTHENTIK_REDIS_PASSWORD=your_redis_password_here

# ============================================
# DOMAIN
# ============================================
# Your main domain (replace with your own domain)
DOMAIN=example.com
# Subdomain for Authentik (replace with your own domain)
AUTH_DOMAIN=auth.example.com

# ============================================
# LOGGING & TELEMETRY
# ============================================
# Log level: debug, info, warning, error
AUTHENTIK_LOG_LEVEL=info
# Disable error reporting to prevent sending data to external services
AUTHENTIK_ERROR_REPORTING__ENABLED=false
# Disable update checks for privacy and offline environments
AUTHENTIK_DISABLE_UPDATE_CHECK=true
# Disable avatar generation to prevent external requests
AUTHENTIK_AVATARS__NONE=true

# ============================================
# SECURITY & SESSION SETTINGS
# ============================================
# Enforce HTTPS for session cookies
AUTHENTIK_SESSION_COOKIE_SECURE=true
# Prevent JavaScript access to session cookies
AUTHENTIK_SESSION_COOKIE_HTTPONLY=true
# CSRF protection: Strict = same domain only, Lax = cross-domain GET requests allowed
AUTHENTIK_SESSION_COOKIE_SAMESITE=Lax