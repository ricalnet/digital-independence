# PostgreSQL Configuration
# openssl rand -base64 60 | tr -d '\n'
PG_PASS=CHANGE_ME_DB_PASS

# Redis Configuration
# openssl rand -base64 60 | tr -d '\n'
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Authentik Configuration
# openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=CHANGE_ME_SECRET_KEY
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Image Configuration
POSTGRES_IMAGE=docker.io/postgres:18-alpine
REDIS_IMAGE=docker.io/redis:alpine
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:latest

# Port Configuration
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# Performance & Resource Tuning
AUTHENTIK_WORKERS=4
AUTHENTIK_WEB__WORKERS=4
AUTHENTIK_DEFAULT__CACHE_TIMEOUT=300
AUTHENTIK_TASK__CELERYD_PREFETCH_MULTIPLIER=1
AUTHENTIK_TASK__CELERYD_MAX_TASKS_PER_CHILD=1000

# Database Connection Pool
AUTHENTIK_POSTGRESQL__CONN_MAX_AGE=300
AUTHENTIK_POSTGRESQL__POOL_SIZE=20
AUTHENTIK_POSTGRESQL__MAX_OVERFLOW=40
