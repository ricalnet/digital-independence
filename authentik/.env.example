# ============================================
# IMAGE TAGS
# ============================================
# Change to a stable image (https://hub.docker.com/r/authentik/server)
AUTHENTIK_IMAGE=authentik/server:latest 
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:alpine

# ============================================
# AUTHENTIK CONFIGURATION
# ============================================
# Generate with: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=
# Minimum 16 characters, use a password generator
AUTHENTIK_POSTGRES_PASSWORD=
# Minimum 16 characters, use a password generator
AUTHENTIK_REDIS_PASSWORD=

# ============================================
# DOMAIN
# ============================================
# Your main domain (replace with your own domain)
DOMAIN=
# Subdomain for Authentik (replace with your own domain)
AUTH_DOMAIN=