# ============================================================
# GLOBALEAKS — Self-signed HTTPS backend (loopback)
# ============================================================
http://globaleaks.example.com {
	bind 127.0.0.1
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		Strict-Transport-Security "max-age=15552000"
	}
	reverse_proxy https://127.0.0.1:4443 {
		flush_interval -1
		transport http {
			tls_insecure_skip_verify
			dial_timeout 10s
		}
		header_up X-Forwarded-Proto "https"
		header_up -X-Real-IP
		header_up -X-Forwarded-For
		header_up -Cf-Connecting-Ip
		header_up -Cf-Ipcountry
	}
}

# ============================================================
# WAZUH DASHBOARD — Self-signed HTTPS backend (loopback)
# ============================================================
http://wazuh.example.com {
	import common
	header Onion-Location "http://service-onion-address.onion{path}"
	reverse_proxy https://127.0.0.1:9521 {
		flush_interval -1
		transport http {
			tls_insecure_skip_verify
			dial_timeout 10s
		}
		header_up X-Forwarded-Proto "https"
		header_up X-Real-IP "{client_ip}"
	}
}

# ============================================================
# TECHNITIUM: DoH + WEB UI
# ============================================================
http://technitium.example.com {
	import common
	handle /dns-query* {
		reverse_proxy 127.0.0.1:9053 {
			header_up Host "{host}"
			header_up X-Forwarded-Proto "https"
			header_up -X-Real-IP
			header_up -X-Forwarded-For
			header_up -Cf-Connecting-Ip
		}
	}
	handle {
		reverse_proxy 127.0.0.1:9524 {
			header_up Host "{host}"
			header_up X-Forwarded-Proto "https"
			header_up X-Real-IP "{client_ip}"
		}
	}
}

# ============================================================
# MASTODON + STREAMING API
# ============================================================
http://mastodon.example.com {
	import common
	header Onion-Location "http://service-onion-address.onion{path}"
	handle /api/v1/streaming/* {
		reverse_proxy 127.0.0.1:4000 {
			flush_interval -1
			header_up X-Forwarded-Proto "https"
			header_up X-Real-IP "{client_ip}"
		}
	}
	handle {
		reverse_proxy 127.0.0.1:4001 {
			flush_interval -1
			header_up X-Forwarded-Proto "https"
			header_up X-Real-IP "{client_ip}"
		}
	}
}