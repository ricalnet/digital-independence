{
	auto_https off
	http_port 8100
	admin off

	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-IP X-Forwarded-For
	}

	log {
		output stdout
		format console
	}
}

# ============================================================
# SNIPPET: LOOPBACK BINDING + SECURITY HEADERS
# ============================================================
(common) {
	bind 127.0.0.1
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
		Strict-Transport-Security "max-age=15552000"
	}
}

# ============================================================
# SNIPPET: STANDARD PROXY (NO ONION)
# args[0] = backend address
# ============================================================
(proxy) {
	import common
	reverse_proxy {args[0]} {
		flush_interval -1
		header_up X-Forwarded-Proto "https"
		header_up X-Real-IP "{client_ip}"
	}
}

# ============================================================
# SNIPPET: SECURE PROXY + UNIQUE ONION LOCATION
# args[0] = backend address, args[1] = onion address
# ============================================================
(secure_proxy) {
	import common
	header Onion-Location "http://{args[1]}{path}"
	reverse_proxy {args[0]} {
		flush_interval -1
		header_up X-Forwarded-Proto "https"
		header_up X-Real-IP "{client_ip}"
	}
}

# ============================================================
# HEALTHCHECK / UNKNOWN HOST FALLBACK
# ============================================================
http://127.0.0.1:8100 {
	bind 127.0.0.1
	respond /health 200
	respond 404
}

# ============================================================
# SERVICES WITHOUT ONION LOCATION
# ============================================================
http://app.example.com {
	import proxy 127.0.0.1:8000
}

# ============================================================
# SERVICES WITH UNIQUE ONION LOCATION
# ============================================================
http://authentik.example.com {
	import secure_proxy 127.0.0.1:9500 service-onion-address.onion
}

http://dashdot.example.com {
	import secure_proxy 127.0.0.1:9501 service-onion-address.onion
}

