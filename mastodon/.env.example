# Mastodon Images
# Change to a stable image (https://hub.docker.com/r/tootsuite/mastodon/)
MASTODON_WEB_IMAGE=ghcr.io/mastodon/mastodon:latest
MASTODON_STREAMING_IMAGE=ghcr.io/mastodon/mastodon-streaming:latest
MASTODON_SIDEKIQ_IMAGE=ghcr.io/mastodon/mastodon:latest
MASTODON_DB_IMAGE=postgres:18-alpine
MASTODON_REDIS_IMAGE=redis:alpine

# openssl rand --hex 32
DB_PASS=CHANGE_ME_DB_PASS
DB_NAME=mastodon_production
DB_USER=postgres

# Ports
WEB_PORT=4001
STREAMING_PORT=4000