# Federation
# ----------
# This identifies your server and cannot be changed safely later
# ----------
LOCAL_DOMAIN=your-domain.com

# ============================================
# REDIS
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# POSTGRESQL
# ============================================
DB_HOST=db
DB_PORT=5432
DB_NAME=mastodon_production
DB_USER=postgres
DB_PASS=

# ============================================
# ELASTICSEARCH (Optional - disabled by default)
# ============================================
ES_ENABLED=false
# ES_HOST=es
# ES_PORT=9200
# ES_USER=elastic
# ES_PASS=password

# ============================================
# SECRETS - GENERATE WITH RAILS SECRET
# ============================================
# Generate with: docker compose run --rm web bundle exec rails secret
# ============================================
SECRET_KEY_BASE=

# ============================================
# ENCRYPTION SECRETS - GENERATE WITH DB:ENCRYPTION:INIT
# ============================================
# Generate with: docker compose run --rm web bundle exec rails db:encryption:init
# ============================================
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=

# ============================================
# WEB PUSH - GENERATE WITH WEBPUSH:VAPID_KEY
# ============================================
# Generate with: docker compose run --rm web bundle exec rails mastodon:webpush:generate_vapid_key
# ============================================
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ============================================
# SMTP (EMAIL)
# ============================================
# For development (mailhog):
# SMTP_SERVER=mailhog
# SMTP_PORT=1025
# SMTP_LOGIN=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=notifications@your-domain.com

# ============================================
# FILE STORAGE (Optional - S3/MinIO)
# ============================================
S3_ENABLED=false
# S3_BUCKET=files.your-domain.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ALIAS_HOST=files.your-domain.com
# S3_REGION=us-east-1
# S3_PROTOCOL=https
# S3_HOSTNAME=your-bucket.s3.amazonaws.com
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_PERMISSION=

# ============================================
# IP AND SESSION RETENTION
# ============================================
IP_RETENTION_PERIOD=31556952
SESSION_RETENTION_PERIOD=31556952

# ============================================
# APPLICATION SETTINGS
# ============================================
# Ports (matching compose.yaml)
WEB_PORT=3000
STREAMING_PORT=4000

# Rails environment
RAILS_ENV=production
NODE_ENV=production

# Trusted proxy for health checks
TRUSTED_PROXY_IP=127.0.0.1

# ============================================
# OPTIONAL: Single-user mode
# ============================================
# SINGLE_USER_MODE=false

# ============================================
# OPTIONAL: Registration mode
# ============================================
# REGISTRATIONS_MODE=open  # open, approved, none

# ============================================
# OPTIONAL: TOR federation
# ============================================
# http_hidden_proxy=http://privoxy:8118
# ALLOW_ACCESS_TO_HIDDEN_SERVICE=true