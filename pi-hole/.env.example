# ============================================
# TIME ZONE
# ============================================
# See all available timezones:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Jakarta

# ============================================
# AUTHENTICATION
# ============================================
# Use a strong password with at least 12 characters
FTLCONF_webserver_api_password=YourStrongPassword123!
WEBPASSWORD=YourStrongPassword123!

# ============================================
# PI-HOLE DNS UPSTREAM
# ============================================
FTLCONF_dns_upstreams=dnscrypt-proxy#5053

# ============================================
# PI-HOLE DNS CONFIGURATION
# ============================================
# Block Encrypted Server Name Indication (ESNI)
FTLCONF_dns_blockESNI=true

# Enable EDNS0 Client Subnet (false = more privacy)
FTLCONF_dns_EDNS0ECS=false

# Ignore localhost DNS queries
FTLCONF_dns_ignoreLocalhost=true

# Show DNSSEC status in response
FTLCONF_dns_showDNSSEC=true

# Analyze only A and AAAA records
FTLCONF_dns_analyzeOnlyAandAAAA=false

# PTR record for Pi-hole
FTLCONF_dns_piholePTR=pi.hole

# Response when busy: BLOCK, REFUSE, or SERVFAIL
FTLCONF_dns_replyWhenBusy=BLOCK

# Time-to-live for blocked domains (in seconds)
FTLCONF_dns_blockTTL=86400

# Domain needed (only serve queries for configured domains)
FTLCONF_dns_domainNeeded=true

# Expand hosts file entries
FTLCONF_dns_expandHosts=false

# Bogus private IPs (prevent RFC 1918 leaks)
FTLCONF_dns_bogusPriv=true

# Enable DNSSEC validation
FTLCONF_dns_dnssec=true

# Interface to listen on (empty = all interfaces)
FTLCONF_dns_interface=

# Listening mode: ALL, LOCAL, or BIND_INTERFACE
FTLCONF_dns_listeningMode=ALL

# Enable query logging
FTLCONF_dns_queryLogging=false

# DNS port
FTLCONF_dns_port=53

# Localise queries (respond with local IP if available)
FTLCONF_dns_localise=false

# ============================================
# PI-HOLE CACHE
# ============================================
# Maximum number of cached DNS entries
FTLCONF_dns_cache_size=10000

# Cache optimizer interval (in seconds)
FTLCONF_dns_cache_optimizer=7200

# TTL for upstream blocked responses
FTLCONF_dns_cache_upstreamBlockedTTL=86400

# ============================================
# PI-HOLE BLOCKING
# ============================================
# Enable/disable ad blocking
FTLCONF_dns_blocking_active=true

# ============================================
# RATE LIMITING
# ============================================
# Maximum queries per client per interval
FTLCONF_dns_rateLimit_count=2000

# Rate limit interval (in seconds)
FTLCONF_dns_rateLimit_interval=60

# ============================================
# DATABASE
# ============================================
# Maximum days to keep queries in database
FTLCONF_database_maxDBdays=7

# Network expiration days
FTLCONF_database_network_expire=7

# ============================================
# PI-HOLE PRIVACY LEVEL
# ============================================
# Privacy level:
# 0 = show all
# 1 = show domains only
# 2 = hide domains
# 3 = fully anonymous (disable all client/domain logging)
FTLCONF_misc_privacylevel=3

# ============================================
# PI-HOLE UID/GID (Optional)
# ============================================
# Uncomment to override default UID/GID if needed
# PIHOLE_UID=999
# PIHOLE_GID=999