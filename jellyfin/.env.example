# Jellyfin Configuration
JELLYFIN_IMAGE=ghcr.io/jellyfin/jellyfin:latest
JELLYFIN_BIND_ADDRESS=127.0.0.1
JELLYFIN_PORT=8096
JELLYFIN_PORT_SSL=8920

# Media Path
MEDIA_PATH=./media

# Public URL
PUBLIC_URL=https://jellyfin.domain.com

# Timezone
TZ=Asia/Jakarta

# Resource Limits
MEMORY_LIMIT=2g
MEMORY_RESERVATION=512m
CPU_LIMIT=2.0

# Network
JELLYFIN_NETWORK_INTERNAL=false