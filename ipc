#!/bin/bash
# ipc - Iptables Controller - KISS
# Firewall management script for iptables

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

PERSISTENCE_METHOD=""
IPTABLES_RULES_FILE="/etc/iptables/rules.v4"
IP6TABLES_RULES_FILE="/etc/iptables/rules.v6"

show_banner() {
    echo -e "${BLUE}╔═══════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║     IPC - Iptables Port Controller        ║${NC}"
    echo -e "${BLUE}║     Firewall Management Tool              ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════╝${NC}"
}

detect_persistence_method() {
    if command -v iptables-save &> /dev/null && command -v iptables-restore &> /dev/null; then
        if systemctl list-unit-files 2>/dev/null | grep -q "netfilter-persistent.service"; then
            PERSISTENCE_METHOD="netfilter-persistent"
        elif systemctl list-unit-files 2>/dev/null | grep -q "iptables-persistent.service"; then
            PERSISTENCE_METHOD="iptables-persistent"
        elif [ -f /etc/redhat-release ] && command -v service &> /dev/null; then
            PERSISTENCE_METHOD="service-save"
        elif [ -f /etc/debian_version ] && [ -d /etc/network/if-pre-up.d ]; then
            PERSISTENCE_METHOD="if-pre-up"
        else
            PERSISTENCE_METHOD="manual-save"
        fi
        return 0
    else
        PERSISTENCE_METHOD="none"
        return 1
    fi
}

show_help() {
    show_banner
    echo ""
    echo -e "${BLUE}Usage: ipc [COMMAND] [OPTIONS]${NC}"
    echo ""
    echo -e "${YELLOW}Default Policies:${NC}"
    echo "  INPUT   : DROP  (deny incoming connections)"
    echo "  OUTPUT  : ACCEPT (allow outgoing connections)"
    echo "  FORWARD : DROP  (routing disabled)"
    echo ""
    echo -e "${YELLOW}Commands:${NC}"
    echo "  setup-persistence           Setup persistence automatically (install package)"
    echo "  check-persist               Check the persistence method being used"
    echo "  init                        Initialize firewall for the first time"
    echo "  enable PORT [IPVERSION] [PROTOCOL]   Enable port (allow incoming)"
    echo "                              IPVERSION: 4 (default), 6, or both"
    echo "                              PROTOCOL: tcp (default), udp, or both"
    echo "  disable PORT [IPVERSION] [PROTOCOL]  Disable port (block incoming)"
    echo "                              IPVERSION: 4 (default), 6, or both"
    echo "                              PROTOCOL: tcp (default), udp, or both"
    echo "  status                      Show status of all rules"
    echo "  reset                       Reset to default (all ports closed)"
    echo "  list                        Show active rules"
    echo "  persist                     Save rules manually"
    echo "  help                        Show this help"
    echo "  version                     Show IPC version"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  ipc setup-persistence        # Setup persistence automatically"
    echo "  ipc check-persist            # Check persistence method"
    echo "  ipc init                     # Initialize firewall for the first time"
    echo "  ipc enable 80                # Enable port 80 TCP (IPv4)"
    echo "  ipc enable 80 4 udp          # Enable port 80 UDP (IPv4)"
    echo "  ipc enable 443 6 tcp         # Enable port 443 TCP (IPv6)"
    echo "  ipc enable 22 both both      # Enable port 22 TCP & UDP (IPv4 & IPv6)"
    echo "  ipc enable 8080              # Add port 8080 without removing other rules"
    echo "  ipc disable 22               # Disable port 22 TCP (IPv4)"
    echo "  ipc disable 53 both udp      # Disable port 53 UDP (IPv4 & IPv6)"
    echo "  ipc status                   # View status of all rules"
    echo "  ipc reset                    # Reset all rules"
    echo "  ipc list                     # View full rules"
    echo "  ipc persist                  # Save rules permanently"
    echo "  ipc version                  # Show IPC version"
}

initialize_firewall() {
    echo -e "${YELLOW}Initializing firewall...${NC}"
    
    if iptables -L INPUT -n | grep -q "ACCEPT.*dpt:"; then
        echo -e "${YELLOW}Firewall already has port rules. Skipping initialization.${NC}"
        echo -e "${YELLOW}Use 'ipc reset' if you want to reset all rules.${NC}"
        return 0
    fi
    
    set_default_policies
    echo -e "${GREEN}Firewall initialized successfully.${NC}"
    echo -e "${GREEN}You can now add ports with 'ipc enable'${NC}"
}

set_default_policies_ipv4() {
    echo -e "${YELLOW}Setting IPv4 default policies...${NC}"
    echo -e "${BLUE}  INPUT   : DROP (deny incoming)${NC}"
    echo -e "${BLUE}  OUTPUT  : ACCEPT (allow outgoing)${NC}"
    echo -e "${BLUE}  FORWARD : DROP (routing disabled)${NC}"
    
    iptables -F
    iptables -X
    iptables -t nat -F
    iptables -t mangle -F
    
    iptables -P INPUT DROP
    iptables -P OUTPUT ACCEPT
    iptables -P FORWARD DROP
    
    iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
    iptables -A INPUT -i lo -j ACCEPT
    
    echo -e "${GREEN}IPv4 default policies have been set${NC}"
    echo -e "${GREEN}  ✓ INPUT DROP (deny incoming)${NC}"
    echo -e "${GREEN}  ✓ OUTPUT ACCEPT (allow outgoing)${NC}"
    echo -e "${GREEN}  ✓ FORWARD DROP (routing disabled)${NC}"
}

set_default_policies_ipv6() {
    echo -e "${YELLOW}Setting IPv6 default policies...${NC}"
    
    if command -v ip6tables &> /dev/null; then
        echo -e "${BLUE}  INPUT   : DROP (deny incoming)${NC}"
        echo -e "${BLUE}  OUTPUT  : ACCEPT (allow outgoing)${NC}"
        echo -e "${BLUE}  FORWARD : DROP (routing disabled)${NC}"
        
        ip6tables -F
        ip6tables -X
        ip6tables -t nat -F 2>/dev/null
        ip6tables -t mangle -F 2>/dev/null
        
        ip6tables -P INPUT DROP
        ip6tables -P OUTPUT ACCEPT
        ip6tables -P FORWARD DROP
        
        ip6tables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
        ip6tables -A INPUT -i lo -j ACCEPT
        
        echo -e "${GREEN}IPv6 default policies have been set${NC}"
        echo -e "${GREEN}  ✓ INPUT DROP (deny incoming)${NC}"
        echo -e "${GREEN}  ✓ OUTPUT ACCEPT (allow outgoing)${NC}"
        echo -e "${GREEN}  ✓ FORWARD DROP (routing disabled)${NC}"
    else
        echo -e "${YELLOW}ip6tables not found, skipping IPv6${NC}"
    fi
}

set_default_policies() {
    set_default_policies_ipv4
    set_default_policies_ipv6
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}Default policies have been set:${NC}"
    echo -e "${GREEN}  INPUT   : DROP (deny incoming)${NC}"
    echo -e "${GREEN}  OUTPUT  : ACCEPT (allow outgoing)${NC}"
    echo -e "${GREEN}  FORWARD : DROP (routing disabled)${NC}"
    echo -e "${GREEN}========================================${NC}"
}

enable_port_ipv4() {
    local PORT=$1
    local PROTOCOL=${2:-tcp}
    
    if ! [[ "$PORT" =~ ^[0-9]+$ ]] || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
        echo -e "${RED}Error: Port must be a number between 1-65535${NC}"
        return 1
    fi
    
    if [ "$PROTOCOL" == "both" ]; then
        if iptables -C INPUT -p tcp --dport $PORT -j ACCEPT 2>/dev/null; then
            echo -e "${YELLOW}Port $PORT is already active (IPv4/TCP)${NC}"
        else
            iptables -A INPUT -p tcp --dport $PORT -j ACCEPT
            echo -e "${GREEN}Port $PORT enabled (IPv4/TCP)${NC}"
        fi
        
        if iptables -C INPUT -p udp --dport $PORT -j ACCEPT 2>/dev/null; then
            echo -e "${YELLOW}Port $PORT is already active (IPv4/UDP)${NC}"
        else
            iptables -A INPUT -p udp --dport $PORT -j ACCEPT
            echo -e "${GREEN}Port $PORT enabled (IPv4/UDP)${NC}"
        fi
    elif [ "$PROTOCOL" == "tcp" ]; then
        if iptables -C INPUT -p tcp --dport $PORT -j ACCEPT 2>/dev/null; then
            echo -e "${YELLOW}Port $PORT is already active (IPv4/TCP)${NC}"
        else
            iptables -A INPUT -p tcp --dport $PORT -j ACCEPT
            echo -e "${GREEN}Port $PORT enabled (IPv4/TCP)${NC}"
        fi
    elif [ "$PROTOCOL" == "udp" ]; then
        if iptables -C INPUT -p udp --dport $PORT -j ACCEPT 2>/dev/null; then
            echo -e "${YELLOW}Port $PORT is already active (IPv4/UDP)${NC}"
        else
            iptables -A INPUT -p udp --dport $PORT -j ACCEPT
            echo -e "${GREEN}Port $PORT enabled (IPv4/UDP)${NC}"
        fi
    fi
}

