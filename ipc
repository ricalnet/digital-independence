#!/bin/bash
# ipc - Iptables Controller
# Firewall management script for iptables

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

PERSISTENCE_METHOD=""
IPTABLES_RULES_FILE="/etc/iptables/rules.v4"
IP6TABLES_RULES_FILE="/etc/iptables/rules.v6"

show_banner() {
    echo -e "${BLUE}╔═══════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║     IPC - Iptables Port Controller        ║${NC}"
    echo -e "${BLUE}║     Firewall Management Tool              ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════╝${NC}"
}

detect_persistence_method() {
    if command -v iptables-save &> /dev/null && command -v iptables-restore &> /dev/null; then
        if systemctl list-unit-files 2>/dev/null | grep -q "netfilter-persistent.service"; then
            PERSISTENCE_METHOD="netfilter-persistent"
        elif systemctl list-unit-files 2>/dev/null | grep -q "iptables-persistent.service"; then
            PERSISTENCE_METHOD="iptables-persistent"
        elif [ -f /etc/redhat-release ] && command -v service &> /dev/null; then
            PERSISTENCE_METHOD="service-save"
        elif [ -f /etc/debian_version ] && [ -d /etc/network/if-pre-up.d ]; then
            PERSISTENCE_METHOD="if-pre-up"
        else
            PERSISTENCE_METHOD="manual-save"
        fi
        return 0
    else
        PERSISTENCE_METHOD="none"
        return 1
    fi
}

show_help() {
    show_banner
    echo ""
    echo -e "${BLUE}Usage: ipc [COMMAND] [OPTIONS]${NC}"
    echo ""
    echo -e "${YELLOW}Default Policies:${NC}"
    echo "  INPUT   : DROP  (deny incoming connections)"
    echo "  OUTPUT  : ACCEPT (allow outgoing connections)"
    echo "  FORWARD : DROP  (routing disabled)"
    echo ""
    echo -e "${YELLOW}Commands:${NC}"
    echo "  setup-persistence           Setup persistence otomatis (install package)"
    echo "  check-persist               Mengecek metode persistence yang digunakan"
    echo "  init                        Inisialisasi firewall pertama kali"
    echo "  enable PORT [IPVERSION] [PROTOCOL]   Mengaktifkan port (allow incoming)"
    echo "                              IPVERSION: 4 (default), 6, atau both"
    echo "                              PROTOCOL: tcp (default), udp, atau both"
    echo "  disable PORT [IPVERSION] [PROTOCOL]  Menonaktifkan port (block incoming)"
    echo "                              IPVERSION: 4 (default), 6, atau both"
    echo "                              PROTOCOL: tcp (default), udp, atau both"
    echo "  status                      Menampilkan status semua aturan"
    echo "  reset                       Mereset ke default (semua port ditutup)"
    echo "  list                        Menampilkan aturan yang aktif"
    echo "  persist                     Menyimpan aturan secara manual"
    echo "  help                        Menampilkan bantuan ini"
    echo "  version                     Menampilkan versi IPC"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  ipc setup-persistence        # Setup persistence otomatis"
    echo "  ipc check-persist            # Cek metode persistence"
    echo "  ipc init                     # Inisialisasi firewall pertama kali"
    echo "  ipc enable 80                # Mengaktifkan port 80 TCP (IPv4)"
    echo "  ipc enable 80 4 udp          # Mengaktifkan port 80 UDP (IPv4)"
    echo "  ipc enable 443 6 tcp         # Mengaktifkan port 443 TCP (IPv6)"
    echo "  ipc enable 22 both both      # Mengaktifkan port 22 TCP & UDP (IPv4 & IPv6)"
    echo "  ipc enable 8080              # Menambah port 8080 tanpa menghapus aturan lain"
    echo "  ipc disable 22               # Menonaktifkan port 22 TCP (IPv4)"
    echo "  ipc disable 53 both udp      # Menonaktifkan port 53 UDP (IPv4 & IPv6)"
    echo "  ipc status                   # Melihat status semua aturan"
