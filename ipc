show_status() {
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}       STATUS FIREWALL                 ${NC}"
    echo -e "${GREEN}========================================${NC}"
    
    echo -e "\n${YELLOW}=== DEFAULT POLICIES ===${NC}"
    echo -e "${BLUE}IPv4:${NC}"
    iptables -L | grep -E "Chain (INPUT|OUTPUT|FORWARD)" | head -3 | while read line; do
        if echo "$line" | grep -q "INPUT.*DROP"; then
            echo -e "  ${GREEN}✓${NC} $line (deny incoming)"
        elif echo "$line" | grep -q "OUTPUT.*ACCEPT"; then
            echo -e "  ${GREEN}✓${NC} $line (allow outgoing)"
        elif echo "$line" | grep -q "FORWARD.*DROP"; then
            echo -e "  ${GREEN}✓${NC} $line (routing disabled)"
        else
            echo "  $line"
        fi
    done
    
    echo -e "\n${BLUE}IPv6:${NC}"
    if command -v ip6tables &> /dev/null; then
        ip6tables -L | grep -E "Chain (INPUT|OUTPUT|FORWARD)" | head -3 | while read line; do
            if echo "$line" | grep -q "INPUT.*DROP"; then
                echo -e "  ${GREEN}✓${NC} $line (deny incoming)"
            elif echo "$line" | grep -q "OUTPUT.*ACCEPT"; then
                echo -e "  ${GREEN}✓${NC} $line (allow outgoing)"
            elif echo "$line" | grep -q "FORWARD.*DROP"; then
                echo -e "  ${GREEN}✓${NC} $line (routing disabled)"
            else
                echo "  $line"
            fi
        done
    else
        echo "  ip6tables tidak tersedia"
    fi
    
    echo -e "\n${YELLOW}=== ATURAN INPUT (Port yang diizinkan) ===${NC}"
    echo -e "\n${BLUE}IPv4:${NC}"
    local ipv4_ports=$(iptables -L INPUT -n | grep -E "ACCEPT.*dpt:")
    if [ -n "$ipv4_ports" ]; then
        iptables -L INPUT -n -v --line-numbers | grep -E "ACCEPT.*dpt:" | while read line; do
            echo "  $line"
        done
    else
        echo -e "  ${RED}(Tidak ada port IPv4 yang diizinkan - semua incoming ditolak)${NC}"
    fi
    
    echo -e "\n${BLUE}IPv6:${NC}"
    if command -v ip6tables &> /dev/null; then
        local ipv6_ports=$(ip6tables -L INPUT -n | grep -E "ACCEPT.*dpt:")
        if [ -n "$ipv6_ports" ]; then
            ip6tables -L INPUT -n -v --line-numbers | grep -E "ACCEPT.*dpt:" | while read line; do
                echo "  $line"
            done
        else
            echo -e "  ${RED}(Tidak ada port IPv6 yang diizinkan - semua incoming ditolak)${NC}"
        fi
    fi
    
    echo -e "\n${YELLOW}=== METODE PERSISTENCE ===${NC}"
    detect_persistence_method
    if [ -n "$PERSISTENCE_METHOD" ] && [ "$PERSISTENCE_METHOD" != "none" ]; then
        echo "  Metode: $PERSISTENCE_METHOD"
        if [ "$PERSISTENCE_METHOD" == "netfilter-persistent" ] || [ "$PERSISTENCE_METHOD" == "iptables-persistent" ]; then
            local service_name="netfilter-persistent"
            [ "$PERSISTENCE_METHOD" == "iptables-persistent" ] && service_name="iptables-persistent"
            echo "  Status: $(systemctl is-active $service_name 2>/dev/null || echo 'inactive')"
        fi
    else
        echo "  ${RED}Metode persistence tidak terdeteksi!${NC}"
        echo "  Aturan akan hilang setelah reboot."
    fi
    echo -e "${GREEN}========================================${NC}"
}

reset_firewall() {
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}PERINGATAN: Ini akan menghapus SEMUA aturan!${NC}"
    echo -e "${RED}========================================${NC}"
    echo -e "${YELLOW}Default policies setelah reset:${NC}"
    echo "  INPUT   : DROP (deny incoming)"
    echo "  OUTPUT  : ACCEPT (allow outgoing)"
    echo "  FORWARD : DROP (routing disabled)"
    echo ""
    read -p "Lanjutkan? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Dibatalkan.${NC}"
        return 1
    fi
    
    echo -e "${RED}Mereset firewall ke default...${NC}"
    set_default_policies
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}Firewall telah direset!${NC}"
    echo -e "${GREEN}  ✓ INPUT DROP (deny incoming)${NC}"
    echo -e "${GREEN}  ✓ OUTPUT ACCEPT (allow outgoing)${NC}"
    echo -e "${GREEN}  ✓ FORWARD DROP (routing disabled)${NC}"
    echo -e "${GREEN}========================================${NC}"
}

list_rules() {
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}       ATURAN IPTABLES LENGKAP         ${NC}"
    echo -e "${GREEN}========================================${NC}"
    
    echo -e "\n${YELLOW}=== DEFAULT POLICIES ===${NC}"
    echo -e "${BLUE}INPUT   : DROP (deny incoming)${NC}"
    echo -e "${BLUE}OUTPUT  : ACCEPT (allow outgoing)${NC}"
    echo -e "${BLUE}FORWARD : DROP (routing disabled)${NC}"
    
    echo -e "\n${YELLOW}=== IPv4 Rules ===${NC}"
    iptables -L -n -v --line-numbers
    
    if command -v ip6tables &> /dev/null; then
        echo -e "\n${YELLOW}=== IPv6 Rules ===${NC}"
        ip6tables -L -n -v --line-numbers
    fi
}

save_rules_persistent() {
    echo -e "${YELLOW}Menyimpan aturan secara persisten...${NC}"
    
    detect_persistence_method
    
    case "$PERSISTENCE_METHOD" in
        "netfilter-persistent")
            echo -e "${GREEN}Menggunakan netfilter-persistent...${NC}"
            mkdir -p /etc/iptables
            
            if command -v iptables-save &> /dev/null; then
                iptables-save > /etc/iptables/rules.v4
                echo -e "${GREEN}Aturan IPv4 disimpan di /etc/iptables/rules.v4${NC}"
            fi
            
            if command -v ip6tables-save &> /dev/null; then
                ip6tables-save > /etc/iptables/rules.v6
                echo -e "${GREEN}Aturan IPv6 disimpan di /etc/iptables/rules.v6${NC}"
            fi
            
            if systemctl restart netfilter-persistent 2>/dev/null; then
                echo -e "${GREEN}Service netfilter-persistent direstart${NC}"
            elif service netfilter-persistent restart 2>/dev/null; then
                echo -e "${GREEN}Service netfilter-persistent direstart${NC}"
            else
                echo -e "${YELLOW}Service tidak bisa direstart, tapi aturan sudah disimpan${NC}"
            fi
            ;;
            
        "iptables-persistent")
            echo -e "${GREEN}Menggunakan iptables-persistent...${NC}"
            mkdir -p /etc/iptables
            
            if command -v iptables-save &> /dev/null; then
                iptables-save > /etc/iptables/rules.v4
                echo -e "${GREEN}Aturan IPv4 disimpan di /etc/iptables/rules.v4${NC}"
            fi
            
            if command -v ip6tables-save &> /dev/null; then
                ip6tables-save > /etc/iptables/rules.v6
                echo -e "${GREEN}Aturan IPv6 disimpan di /etc/iptables/rules.v6${NC}"
            fi
            
            if systemctl restart iptables-persistent 2>/dev/null; then
                echo -e "${GREEN}Service iptables-persistent direstart${NC}"
            else
                service iptables-persistent restart 2>/dev/null
            fi
            ;;
            
        "service-save")
            echo -e "${GREEN}Menggunakan service iptables save...${NC}"
            service iptables save
            if [ $? -eq 0 ]; then
                echo -e "${GREEN}Aturan berhasil disimpan${NC}"
            else
                echo -e "${RED}Gagal menyimpan aturan${NC}"
            fi
            ;;
            
        "if-pre-up")
            echo -e "${GREEN}Menggunakan if-pre-up method...${NC}"
            mkdir -p /etc/iptables
            iptables-save > /etc/iptables/rules.v4
            echo -e "${GREEN}Aturan IPv4 disimpan di /etc/iptables/rules.v4${NC}"
            
            if command -v ip6tables-save &> /dev/null; then
                ip6tables-save > /etc/iptables/rules.v6
                echo -e "${GREEN}Aturan IPv6 disimpan di /etc/iptables/rules.v6${NC}"
            fi
            
            cat > /etc/network/if-pre-up.d/iptables << 'EOF'
#!/bin/sh
/sbin/iptables-restore < /etc/iptables/rules.v4
if [ -f /etc/iptables/rules.v6 ] && command -v ip6tables-restore &> /dev/null; then
    /sbin/ip6tables-restore < /etc/iptables/rules.v6
fi
EOF
            chmod +x /etc/network/if-pre-up.d/iptables
            echo -e "${GREEN}Restore script dibuat di /etc/network/if-pre-up.d/iptables${NC}"
            ;;
            
        "manual-save")
            echo -e "${YELLOW}Menggunakan metode manual...${NC}"
            mkdir -p /etc/iptables
            iptables-save > /etc/iptables/rules.v4
            echo -e "${GREEN}Aturan IPv4 disimpan di /etc/iptables/rules.v4${NC}"
            
            if command -v ip6tables-save &> /dev/null; then
                ip6tables-save > /etc/iptables/rules.v6
                echo -e "${GREEN}Aturan IPv6 disimpan di /etc/iptables/rules.v6${NC}"
            fi
            
            echo -e "${YELLOW}Untuk persistence yang lebih baik, install:${NC}"
            echo "  Debian/Ubuntu: apt install iptables-persistent"
            echo "  RHEL/CentOS: yum install iptables-services"
            ;;
            
        "none"|*)
            echo -e "${RED}ERROR: Tidak ada metode persistence yang ditemukan!${NC}"
            echo -e "${YELLOW}Install salah satu package berikut:${NC}"
            echo "  Debian/Ubuntu: apt install iptables-persistent"
            echo "  RHEL/CentOS: yum install iptables-services"
            echo "  Atau gunakan: ipc setup-persistence"
            return 1
            ;;
    esac
    
    echo -e "${GREEN}Aturan berhasil disimpan secara persisten!${NC}"
}

setup_persistence() {
    echo -e "${YELLOW}Setup persistence otomatis...${NC}"
    
    if [ -f /etc/debian_version ]; then
        echo -e "${GREEN}Mendeteksi sistem Debian/Ubuntu${NC}"
        
        if dpkg -l | grep -q "iptables-persistent\|netfilter-persistent"; then
            echo -e "${GREEN}Package persistence sudah terinstall${NC}"
        else
            echo -e "${YELLOW}Menginstall iptables-persistent...${NC}"
            apt update
            DEBIAN_FRONTEND=noninteractive apt install -y iptables-persistent
        fi
        
        mkdir -p /etc/iptables
        
        if command -v iptables-save &> /dev/null; then
            iptables-save > /etc/iptables/rules.v4
        fi
        
        if command -v ip6tables-save &> /dev/null; then
            ip6tables-save > /etc/iptables/rules.v6
        fi
        
        if systemctl list-unit-files 2>/dev/null | grep -q "netfilter-persistent.service"; then
            echo -e "${GREEN}Menggunakan netfilter-persistent.service${NC}"
            systemctl enable netfilter-persistent
            systemctl start netfilter-persistent
            systemctl status netfilter-persistent --no-pager
        elif systemctl list-unit-files 2>/dev/null | grep -q "iptables-persistent.service"; then
            echo -e "${GREEN}Menggunakan iptables-persistent.service${NC}"
            systemctl enable iptables-persistent
            systemctl start iptables-persistent
            systemctl status iptables-persistent --no-pager
        else
            echo -e "${YELLOW}Service tidak ditemukan, tapi aturan sudah disimpan${NC}"
        fi
        
    elif [ -f /etc/redhat-release ]; then
        echo -e "${GREEN}Mendeteksi sistem RHEL/CentOS/Fedora${NC}"
        if ! rpm -q iptables-services &> /dev/null; then
            echo -e "${YELLOW}Menginstall iptables-services...${NC}"
            yum install -y iptables-services
        else
            echo -e "${GREEN}iptables-services sudah terinstall${NC}"
        fi
        systemctl enable iptables
        systemctl start iptables
        service iptables save
        
    else
        echo -e "${RED}Sistem tidak didukung untuk setup otomatis${NC}"
        echo -e "${YELLOW}Silakan install secara manual:${NC}"
        echo "  Debian/Ubuntu: apt install iptables-persistent"
        echo "  RHEL/CentOS: yum install iptables-services"
        return 1
    fi
    
    echo -e "${GREEN}Persistence berhasil di-setup!${NC}"
    echo -e "${GREEN}Aturan saat ini telah disimpan dan akan tetap aktif setelah reboot${NC}"
}

check_persistence() {
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}    CEK METODE PERSISTENCE             ${NC}"
    echo -e "${GREEN}========================================${NC}"
    
    detect_persistence_method
    
    echo -e "\n${YELLOW}Metode yang terdeteksi: ${NC}$PERSISTENCE_METHOD"
    
    case "$PERSISTENCE_METHOD" in
        "netfilter-persistent")
            echo "  Package: netfilter-persistent / iptables-persistent"
            echo "  Service: $(systemctl status netfilter-persistent 2>/dev/null | grep Active || echo 'inactive')"
            echo "  Rules file: /etc/iptables/rules.v4 (IPv4)"
            echo "  Rules file: /etc/iptables/rules.v6 (IPv6)"
            if [ -f /etc/iptables/rules.v4 ]; then
                echo "  IPv4 Rules exist: Yes"
                echo "  IPv4 Rules size: $(du -h /etc/iptables/rules.v4 | cut -f1)"
            else
                echo "  ${RED}IPv4 Rules file tidak ditemukan!${NC}"
            fi
            if [ -f /etc/iptables/rules.v6 ]; then
                echo "  IPv6 Rules exist: Yes"
                echo "  IPv6 Rules size: $(du -h /etc/iptables/rules.v6 | cut -f1)"
            else
                echo "  ${YELLOW}IPv6 Rules file tidak ditemukan${NC}"
            fi
            ;;
        "iptables-persistent")
            if [ -f /etc/debian_version ]; then
                echo "  Package: iptables-persistent"
                echo "  Service: $(systemctl status iptables-persistent 2>/dev/null | grep Active || echo 'inactive')"
                echo "  Rules file: /etc/iptables/rules.v4"
            elif [ -f /etc/redhat-release ]; then
                echo "  Package: iptables-services"
                echo "  Service: $(systemctl status iptables 2>/dev/null | grep Active || echo 'inactive')"
                echo "  Rules file: /etc/sysconfig/iptables"
            fi
            ;;
        "service-save")
            echo "  Method: service iptables save"
            echo "  Rules file: /etc/sysconfig/iptables"
            ;;
        "if-pre-up")
            echo "  Method: if-pre-up.d script"
            echo "  Rules file: /etc/iptables/rules.v4"
            echo "  Script: /etc/network/if-pre-up.d/iptables"
            ;;
        "manual-save")
            echo "  Method: Manual save"
            if [ -f /etc/iptables/rules.v4 ]; then
                echo "  IPv4 Rules file: /etc/iptables/rules.v4 (exists)"
            else
                echo "  ${RED}Tidak ada file rules IPv4 ditemukan!${NC}"
            fi
            if [ -f /etc/iptables/rules.v6 ]; then
                echo "  IPv6 Rules file: /etc/iptables/rules.v6 (exists)"
            fi
            ;;
        "none")
            echo -e "${RED}Tidak ada metode persistence terdeteksi!${NC}"
            echo -e "${YELLOW}Aturan akan hilang setelah reboot.${NC}"
            echo -e "${YELLOW}Jalankan: ipc setup-persistence${NC}"
            ;;
    esac
}

if [ "$EUID" -ne 0 ]; then 
    echo -e "${RED}Error: Script harus dijalankan sebagai root (sudo)${NC}"
    exit 1
fi

if ! command -v iptables &> /dev/null; then
    echo -e "${RED}Error: iptables tidak ditemukan. Install dengan: apt install iptables atau yum install iptables${NC}"
    exit 1
fi

case "$1" in
    init)
        initialize_firewall
        save_rules_persistent
        ;;
    enable)
        if [ -z "$2" ]; then
            echo -e "${RED}Error: Port harus ditentukan${NC}"
            show_help
            exit 1
        fi
        PORT="$2"
        IPVERSION="${3:-4}"
        PROTOCOL="${4:-tcp}"
        enable_port "$PORT" "$IPVERSION" "$PROTOCOL"
        save_rules_persistent
        ;;
    disable)
        if [ -z "$2" ]; then
            echo -e "${RED}Error: Port harus ditentukan${NC}"
            show_help
            exit 1
        fi
        PORT="$2"
        IPVERSION="${3:-4}"
        PROTOCOL="${4:-tcp}"
        disable_port "$PORT" "$IPVERSION" "$PROTOCOL"
        save_rules_persistent
        ;;
    status)
        show_status
        ;;
    reset)
        reset_firewall
        save_rules_persistent
        ;;
    list)
        list_rules
        ;;
    persist)
        save_rules_persistent
        ;;
    setup-persistence)
        setup_persistence
        ;;
    check-persist)
        check_persistence
        ;;
    help|--help|-h)
        show_help
        ;;
    version|--version|-v)
        echo "ipc (Iptables Controller) v1.0"
        echo "Firewall Management Tool"
        ;;
    *)
        echo -e "${RED}Error: Command tidak dikenal: $1${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac

exit 0