}

initialize_firewall() {
    echo -e "${YELLOW}Inisialisasi firewall...${NC}"
    
    if iptables -L INPUT -n | grep -q "ACCEPT.*dpt:"; then
        echo -e "${YELLOW}Firewall sudah memiliki aturan port. Lewati inisialisasi.${NC}"
        echo -e "${YELLOW}Gunakan 'ipc reset' jika ingin mereset semua aturan.${NC}"
        return 0
    fi
    
    set_default_policies
    echo -e "${GREEN}Firewall berhasil diinisialisasi.${NC}"
    echo -e "${GREEN}Sekarang Anda bisa menambah port dengan 'ipc enable'${NC}"
}

set_default_policies_ipv4() {
    echo -e "${YELLOW}Mengatur default policies IPv4...${NC}"
    echo -e "${BLUE}  INPUT   : DROP (deny incoming)${NC}"
    echo -e "${BLUE}  OUTPUT  : ACCEPT (allow outgoing)${NC}"
    echo -e "${BLUE}  FORWARD : DROP (routing disabled)${NC}"
    
    iptables -F
    iptables -X
    iptables -t nat -F
    iptables -t mangle -F
    
    iptables -P INPUT DROP
    iptables -P OUTPUT ACCEPT
    iptables -P FORWARD DROP
    
    iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
    iptables -A INPUT -i lo -j ACCEPT
    
    echo -e "${GREEN}Default policies IPv4 telah diset${NC}"
    echo -e "${GREEN}  ✓ INPUT DROP (deny incoming)${NC}"
    echo -e "${GREEN}  ✓ OUTPUT ACCEPT (allow outgoing)${NC}"
    echo -e "${GREEN}  ✓ FORWARD DROP (routing disabled)${NC}"
}

set_default_policies_ipv6() {
    echo -e "${YELLOW}Mengatur default policies IPv6...${NC}"
    
    if command -v ip6tables &> /dev/null; then
        echo -e "${BLUE}  INPUT   : DROP (deny incoming)${NC}"
        echo -e "${BLUE}  OUTPUT  : ACCEPT (allow outgoing)${NC}"
        echo -e "${BLUE}  FORWARD : DROP (routing disabled)${NC}"
        
        ip6tables -F
        ip6tables -X
        ip6tables -t nat -F 2>/dev/null
        ip6tables -t mangle -F 2>/dev/null
        
        ip6tables -P INPUT DROP
        ip6tables -P OUTPUT ACCEPT
        ip6tables -P FORWARD DROP
        
        ip6tables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
        ip6tables -A INPUT -i lo -j ACCEPT
        
        echo -e "${GREEN}Default policies IPv6 telah diset${NC}"
        echo -e "${GREEN}  ✓ INPUT DROP (deny incoming)${NC}"
        echo -e "${GREEN}  ✓ OUTPUT ACCEPT (allow outgoing)${NC}"
        echo -e "${GREEN}  ✓ FORWARD DROP (routing disabled)${NC}"
    else
        echo -e "${YELLOW}ip6tables tidak ditemukan, lewati IPv6${NC}"
    fi
}

set_default_policies() {
    set_default_policies_ipv4
    set_default_policies_ipv6
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}Default policies telah diset:${NC}"
    echo -e "${GREEN}  INPUT   : DROP (deny incoming)${NC}"
    echo -e "${GREEN}  OUTPUT  : ACCEPT (allow outgoing)${NC}"
    echo -e "${GREEN}  FORWARD : DROP (routing disabled)${NC}"
    echo -e "${GREEN}========================================${NC}"
}

enable_port_ipv4() {
    local PORT=$1
    local PROTOCOL=${2:-tcp}
    
    if ! [[ "$PORT" =~ ^[0-9]+$ ]] || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
        echo -e "${RED}Error: Port harus berupa angka antara 1-65535${NC}"
        return 1
    fi
    
    if [ "$PROTOCOL" == "both" ]; then
        if iptables -C INPUT -p tcp --dport $PORT -j ACCEPT 2>/dev/null; then
            echo -e "${YELLOW}Port $PORT sudah aktif (IPv4/TCP)${NC}"
        else
            iptables -A INPUT -p tcp --dport $PORT -j ACCEPT
            echo -e "${GREEN}Port $PORT diaktifkan (IPv4/TCP)${NC}"
        fi
        
        if iptables -C INPUT -p udp --dport $PORT -j ACCEPT 2>/dev/null; then
            echo -e "${YELLOW}Port $PORT sudah aktif (IPv4/UDP)${NC}"
        else
            iptables -A INPUT -p udp --dport $PORT -j ACCEPT
            echo -e "${GREEN}Port $PORT diaktifkan (IPv4/UDP)${NC}"
        fi
    elif [ "$PROTOCOL" == "tcp" ]; then
        if iptables -C INPUT -p tcp --dport $PORT -j ACCEPT 2>/dev/null; then
            echo -e "${YELLOW}Port $PORT sudah aktif (IPv4/TCP)${NC}"
        else
            iptables -A INPUT -p tcp --dport $PORT -j ACCEPT
            echo -e "${GREEN}Port $PORT diaktifkan (IPv4/TCP)${NC}"
        fi
    elif [ "$PROTOCOL" == "udp" ]; then
        if iptables -C INPUT -p udp --dport $PORT -j ACCEPT 2>/dev/null; then
            echo -e "${YELLOW}Port $PORT sudah aktif (IPv4/UDP)${NC}"
        else
            iptables -A INPUT -p udp --dport $PORT -j ACCEPT
            echo -e "${GREEN}Port $PORT diaktifkan (IPv4/UDP)${NC}"
        fi
    fi
}

