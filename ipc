enable_port() {
    local PORT=$1
    local IPVERSION=${2:-4}
    local PROTOCOL=${3:-tcp}
    
    case "$PROTOCOL" in
        tcp|TCP)
            PROTOCOL="tcp"
            ;;
        udp|UDP)
            PROTOCOL="udp"
            ;;
        both|BOTH)
            PROTOCOL="both"
            ;;
        *)
            echo -e "${RED}Error: Protocol must be tcp, udp, or both${NC}"
            return 1
            ;;
    esac
    
    case "$IPVERSION" in
        4)
            enable_port_ipv4 "$PORT" "$PROTOCOL"
            ;;
        6)
            enable_port_ipv6 "$PORT" "$PROTOCOL"
            ;;
        both)
            enable_port_ipv4 "$PORT" "$PROTOCOL"
            enable_port_ipv6 "$PORT" "$PROTOCOL"
            ;;
        *)
            echo -e "${RED}Error: IP version must be 4, 6, or both${NC}"
            return 1
            ;;
    esac
}

