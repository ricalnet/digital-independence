# ============================================================
# SYSTEM CONFIGURATION
# ============================================================
TZ=Asia/Jakarta

# ============================================================
# TECHNITIUM IMAGE
# ============================================================
TECHNITIUM_DNS_IMAGE=docker.io/technitium/dns-server:latest

# ============================================================
# TECHNITIUM RESOURCE LIMITS
# ============================================================
# Maximum RAM memory limit for the container
TECHNITIUM_MEM_LIMIT=384m

# Minimum guaranteed RAM memory allocation for the container
TECHNITIUM_MEM_RESERVATION=128m

# Combined limit for RAM memory and swap space
TECHNITIUM_MEMSWAP_LIMIT=384m

# CPU resource limit (0.5 = maximum of 50% of a single CPU core)
TECHNITIUM_CPUS=0.5