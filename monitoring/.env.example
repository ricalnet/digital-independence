# ============================================
# PROMETHEUS
# ============================================
PROMETHEUS_IMAGE=docker.io/prom/prometheus:latest
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=10GB
PROMETHEUS_LOG_LEVEL=info
PROMETHEUS_MEM_LIMIT=1g
PROMETHEUS_MEM_RESERVATION=256m
PROMETHEUS_MEMSWAP_LIMIT=1.2g
PROMETHEUS_CPUS=0.8

# ============================================
# GRAFANA
# ============================================
GRAFANA_IMAGE=docker.io/grafana/grafana-oss:latest
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
# Generate: openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
# Generate: openssl rand -hex 32
GRAFANA_SECRET_KEY=CHANGE_ME_GRAFANA_SECRET_KEY
GRAFANA_ALLOW_SIGNUP=false
GRAFANA_ALLOW_ORG_CREATE=false
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_ANONYMOUS_ORG_ROLE=Viewer
GRAFANA_BASIC_ENABLED=true
GRAFANA_DISABLE_LOGIN_FORM=false
GRAFANA_ROOT_URL=http://localhost:3003
GRAFANA_DOMAIN=localhost
GRAFANA_PROTOCOL=http
GRAFANA_LOG_LEVEL=warn
GRAFANA_INSTALL_PLUGINS=
GRAFANA_MEM_LIMIT=512m
GRAFANA_MEM_RESERVATION=128m
GRAFANA_MEMSWAP_LIMIT=640m
GRAFANA_CPUS=0.5

# ============================================
# NODE EXPORTER
# ============================================
NODE_EXPORTER_IMAGE=docker.io/prom/node-exporter:latest
NODE_EXPORTER_BIND_ADDRESS=127.0.0.1
NODE_EXPORTER_PORT=9100
NODE_EXPORTER_MEM_LIMIT=128m
NODE_EXPORTER_MEM_RESERVATION=32m
NODE_EXPORTER_MEMSWAP_LIMIT=128m
NODE_EXPORTER_CPUS=0.2

# ============================================
# PODMAN EXPORTER
# ============================================
PODMAN_EXPORTER_IMAGE=quay.io/navidys/prometheus-podman-exporter:latest
PODMAN_EXPORTER_BIND_ADDRESS=127.0.0.1
PODMAN_EXPORTER_PORT=9882
PODMAN_SOCKET_PATH=/run/user/1000/podman/podman.sock
PODMAN_EXPORTER_MEM_LIMIT=128m
PODMAN_EXPORTER_MEM_RESERVATION=32m
PODMAN_EXPORTER_MEMSWAP_LIMIT=128m
PODMAN_EXPORTER_CPUS=0.2

# ============================================
# ALERTMANAGER
# ============================================
ALERTMANAGER_IMAGE=docker.io/prom/alertmanager:latest
ALERTMANAGER_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_PORT=9093
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
ALERTMANAGER_LOG_LEVEL=info
ALERTMANAGER_MEM_LIMIT=256m
ALERTMANAGER_MEM_RESERVATION=64m
ALERTMANAGER_MEMSWAP_LIMIT=320m
ALERTMANAGER_CPUS=0.3