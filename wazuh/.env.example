# -------------------- WAZUH VERSION --------------------
WAZUH_VERSION=4.14.7

# -------------------- WAZUH INDEXER --------------------
INDEXER_USERNAME=admin
INDEXER_PASSWORD=CHANGE_ME_INDEXER_PASSWORD
INDEXER_HEAP_SIZE=384m
INDEXER_MAX_HEAP=512m

# -------------------- WAZUH API --------------------
API_USERNAME=wazuh-wui
API_PASSWORD=CHANGE_ME_API_PASSWORD

# -------------------- WAZUH DASHBOARD --------------------
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD

# -------------------- SSL CERTIFICATES --------------------
SSL_VERIFICATION_MODE=full

# -------------------- RESOURCE LIMITS --------------------
# Manager
MANAGER_CPU_LIMIT=1.0
MANAGER_CPU_RESERVATION=0.3
MANAGER_MEMORY_LIMIT=1G
MANAGER_MEMORY_RESERVATION=512M

# Indexer
INDEXER_CPU_LIMIT=0.6
INDEXER_CPU_RESERVATION=0.2
INDEXER_MEMORY_LIMIT=768M
INDEXER_MEMORY_RESERVATION=384M

# Dashboard
DASHBOARD_CPU_LIMIT=0.4
DASHBOARD_CPU_RESERVATION=0.15
DASHBOARD_MEMORY_LIMIT=512M
DASHBOARD_MEMORY_RESERVATION=192M

# -------------------- PORT BINDING --------------------
MANAGER_PORT_1514=127.0.0.1:1514:1514
MANAGER_PORT_1515=127.0.0.1:1515:1515
MANAGER_PORT_55000=127.0.0.1:55000:55000
# MANAGER_PORT_514=127.0.0.1:514:514/udp

INDEXER_PORT_9200=127.0.0.1:9200:9200
DASHBOARD_PORT_443=127.0.0.1:8443:5601
