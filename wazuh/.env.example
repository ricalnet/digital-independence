# -------------------- WAZUH INDEXER --------------------
INDEXER_USERNAME=admin
INDEXER_PASSWORD=your-secret-password
INDEXER_HEAP_SIZE=512m
INDEXER_MAX_HEAP=768m

# -------------------- WAZUH API --------------------
API_USERNAME=wazuh-wui
API_PASSWORD=your-secret-password

# -------------------- WAZUH DASHBOARD --------------------
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=your-secret-password

# -------------------- SSL CERTIFICATES --------------------
SSL_VERIFICATION_MODE=full

# -------------------- RESOURCE LIMITS --------------------
MANAGER_CPU_LIMIT=1.5
MANAGER_CPU_RESERVATION=0.5
MANAGER_MEMORY_LIMIT=2G
MANAGER_MEMORY_RESERVATION=1G

INDEXER_CPU_LIMIT=0.8
INDEXER_CPU_RESERVATION=0.3
INDEXER_MEMORY_LIMIT=1G
INDEXER_MEMORY_RESERVATION=512M

DASHBOARD_CPU_LIMIT=0.5
DASHBOARD_CPU_RESERVATION=0.2
DASHBOARD_MEMORY_LIMIT=768M
DASHBOARD_MEMORY_RESERVATION=256M

# -------------------- PORT BINDING --------------------
MANAGER_PORT_1514=127.0.0.1:1514:1514
MANAGER_PORT_1515=127.0.0.1:1515:1515
MANAGER_PORT_55000=127.0.0.1:55000:55000
