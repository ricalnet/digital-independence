# Obfs4 Bridge Configuration
OBFS4_BRIDGE_IMAGE=docker.io/thetorproject/obfs4-bridge:latest

# OR Port (Tor relay port)
OR_PORT=8443

# PT Port (Pluggable Transport port)
PT_PORT=9443

# Email for Tor Project notifications
EMAIL=

# Nickname for the bridge
NICKNAME=

# Bind Address (0.0.0.0 for public, 127.0.0.1 for local only)
OBFS4_BIND_ADDRESS=0.0.0.0