# LinkStack Configuration
LINKSTACK_IMAGE=docker.io/linkstackorg/linkstack:latest
LINKSTACK_BIND_ADDRESS=127.0.0.1
LINKSTACK_HTTP_PORT=8003

# MySQL Configuration
MYSQL_IMAGE=docker.io/mysql:8.0
# openssl rand --hex 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=linkstack
MYSQL_USER=linkstack
# openssl rand --hex 32
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# MySQL Performance
MYSQL_INNODB_BUFFER_POOL_SIZE=128M
MYSQL_MAX_ALLOWED_PACKET=16M

# LinkStack Environment
TZ=Asia/Jakarta
SERVER_ADMIN=admin.domain.com
HTTP_SERVER_NAME=linkstack.domain.com
HTTPS_SERVER_NAME=linkstack.domain.com
LOG_LEVEL=info
PHP_MEMORY_LIMIT=256M
UPLOAD_MAX_FILESIZE=8M

# Network
LINKSTACK_NETWORK_INTERNAL=false
