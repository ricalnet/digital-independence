# ============================================
# OPEN WEBUI IMAGE
# ============================================
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# ============================================
# REQUIRED - MUST BE FILLED
# ============================================

# Secret Key for session encryption
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=your-secret-key-here

# Public domain (without protocol)
DOMAIN=openwebui.domain.com

# Full application URL (with protocol)
WEBUI_URL=https://openwebui.domain.com

# Redis Password
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ============================================
# OPTIONAL (Has default values)
# ============================================

# Application Name (appears in UI)
WEBUI_NAME=AI

# Ollama URL (default for internal network)
OLLAMA_BASE_URL=http://ollama:11434

# Hugging Face Token (for higher rate limits)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# Enable/Disable Authentication
WEBUI_AUTH=true

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Maximum requests per window
RATE_LIMIT_REQUESTS=100

# Window in seconds
RATE_LIMIT_WINDOW=60

# Login Controls
ENABLE_LOGIN_FORM=true
ENABLE_PASSWORD_AUTH=true

# Session & Cookie Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true

# Security Headers
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true

# CORS Configuration
CORS_ALLOW_ORIGIN=https://openwebui.domain.com
CORS_ALLOW_CREDENTIALS=true

# ============================================
# REDIS CONFIGURATION
# ============================================

# Redis URL
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# Session Store Type
SESSION_STORE_TYPE=redis

# Rate Limiting Store Type
RATE_LIMIT_STORE_TYPE=redis

# ============================================
# OAUTH/SSO (Optional
# ============================================

# To enable SSO, uncomment the lines below and fill in your values
#
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_PROVIDER_NAME=Authentik
# OPENID_PROVIDER_URL=https://authentik.company/application/o/application-slug/.well-known/openid-configuration
# OPENID_REDIRECT_URI=https://openwebui.domain.com/oauth/oidc/callback
# OAUTH_SCOPES=openid email profile
# ENABLE_OAUTH_ROLE_MANAGEMENT=true
# ENABLE_OAUTH_SIGNUP=true
# OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true

# ============================================
# PERFORMANCE & SCALING
# ============================================

# Worker Processes (adjust to CPU cores)
WORKERS=4

# Worker Timeout (seconds)
WORKER_TIMEOUT=120

# Maximum Upload Size (bytes)
# 10MB = 10485760
MAX_UPLOAD_SIZE=10485760

# Keep Alive Timeout (seconds)
TIMEOUT_KEEP_ALIVE=5

# ============================================
# LOGGING & MONITORING
# ============================================

# Log Level: debug, info, warning, error, critical
LOG_LEVEL=info

# Enable Debug Logs (set false for production)
ENABLE_DEBUG_LOGS=false