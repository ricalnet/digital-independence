# ============================================
# OpenWebUI Configuration
# ============================================
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OPENWEBUI_BIND_ADDRESS=127.0.0.1
OPENWEBUI_PORT=3000

# WebUI Settings
WEBUI_NAME=MY AI Assistant
WEBUI_URL=https://openwebui.domain.com
# Generate with: openssl rand --hex 32
WEBUI_SECRET_KEY=CHANGE_ME_WEBUI_SECRET_KEY
WEBUI_AUTH=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Session & Cache
SESSION_STORE_TYPE=redis
RATE_LIMIT_STORE_TYPE=redis

# Security
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true
CORS_ALLOW_CREDENTIALS=true

# Workers
WORKERS=2
WORKER_TIMEOUT=120
MAX_UPLOAD_SIZE=10485760
TIMEOUT_KEEP_ALIVE=5

# Logging
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false

# ============================================
# Redis Configuration
# ============================================
REDIS_IMAGE=docker.io/redis:alpine
# Generate with: openssl rand --hex 32
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_CONFIG_RENAME=OPENWEBUI_CONFIG

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_IMAGE=docker.io/ollama/ollama:latest
OLLAMA_BIND_ADDRESS=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_HOST=0.0.0.0
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_THREADS=4
OLLAMA_MAX_QUEUE=64
OLLAMA_LOAD_TIMEOUT=5m
OLLAMA_FLASH_ATTENTION=false
OLLAMA_KV_CACHE_TYPE=f16
OLLAMA_DEBUG=false
OLLAMA_MEM_LIMIT=4g
OLLAMA_MEM_RESERVATION=2g
OLLAMA_MEMSWAP_LIMIT=4g
OLLAMA_CPUS=2.0

# ============================================
# OAuth/OIDC Configuration (Optional)
# ============================================
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_PROVIDER_NAME=
OPENID_PROVIDER_URL=
OPENID_REDIRECT_URI=
ENABLE_OAUTH_SIGNUP=false
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
ENABLE_LOGIN_FORM=true
ENABLE_PASSWORD_AUTH=true
OAUTH_SCOPES=openid email profile roles
ENABLE_OAUTH_ROLE_MANAGEMENT=false

# ============================================
# Domain
# ============================================
DOMAIN=openwebui.domain.com
CORS_ALLOW_ORIGIN=https://openwebui.domain.com

# ============================================
# Hugging Face Token (Optional)
# ============================================
# HF_TOKEN=