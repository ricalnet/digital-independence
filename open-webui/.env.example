# ============================================
# OpenWebUI Environment Configuration
# ============================================

# Image Configuration
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OPENWEBUI_BIND_ADDRESS=127.0.0.1
OPENWEBUI_PORT=3000

# ============================================
# Redis Configuration
# ============================================
REDIS_IMAGE=docker.io/redis:alpine
# openssl rand --hex 32
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_CONFIG_RENAME=OPENWEBUI_CONFIG

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_BASE_URL=http://ollama:11434

# ============================================
# WebUI Core Configuration
# ============================================
# openssl rand --hex 32
WEBUI_SECRET_KEY=CHANGE_ME_WEBUI_SECRET_KEY
WEBUI_NAME=My AI Assistant
WEBUI_URL=https://openwebui.domain.com
WEBUI_AUTH=true

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# Session & Rate Limit Store
# ============================================
SESSION_STORE_TYPE=redis
RATE_LIMIT_STORE_TYPE=redis

# ============================================
# Hugging Face Token (Optional)
# ============================================
HF_TOKEN=

# ============================================
# OAuth / OIDC Configuration (Optional)
# ============================================
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_PROVIDER_NAME=
OPENID_PROVIDER_URL=
OPENID_REDIRECT_URI=
ENABLE_OAUTH_SIGNUP=false
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
ENABLE_LOGIN_FORM=true
ENABLE_PASSWORD_AUTH=true

# ============================================
# CORS Configuration
# ============================================
DOMAIN=openwebui.domain.com
CORS_ALLOW_ORIGIN=https://${DOMAIN:-localhost}
CORS_ALLOW_CREDENTIALS=true

# ============================================
# Session Security
# ============================================
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true

# ============================================
# Security Headers
# ============================================
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true

# ============================================
# Worker Configuration
# ============================================
WORKERS=4
WORKER_TIMEOUT=120
MAX_UPLOAD_SIZE=10485760
TIMEOUT_KEEP_ALIVE=5

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false

# ============================================
# Network
# ============================================
OPENWEBUI_NETWORK_INTERNAL=false
