# Vaultwarden Image
# Change to a stable image (https://hub.docker.com/r/vaultwarden/server)
VAULTWARDEN_IMAGE=docker.io/vaultwarden/server:alpine

# Vaultwarden Configuration
DOMAIN=https://your-domain.com
SIGNUPS_ALLOWED=false
ADMIN_TOKEN="$argon2id$v=19"
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Generate a strong ADMIN_TOKEN using:
# echo -n "your-secret-password" | argon2 "$(openssl rand -base64 16)" -id -t 3 -m 16 -p 4 -l 32
# ./edit-config.sh

# # SSO Configuration (Optional)
# SSO_ENABLED=true
# SSO_AUTHORITY=https://authentik.domain.com/application/o/<application_slug>/
# SSO_CLIENT_ID=<Client ID from authentik>
# SSO_CLIENT_SECRET=<Client Secret from authentik>
# SSO_SCOPES=email profile offline_access
# SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=false
# SSO_CLIENT_CACHE_EXPIRATION=0
# SSO_ONLY=false # Set to true to disable email and master password login and require SSO
# SSO_SIGNUPS_MATCH_EMAIL=true # Match first SSO login to an existing account by email

# Check your host user ID with: id
# Default: 1000:1000 (first user on most Linux systems)
# Change this to match your host user's UID:GID if needed
UID=1000
GID=1000

# Logging
LOG_LEVEL=info