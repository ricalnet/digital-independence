# Vaultwarden Configuration
VAULTWARDEN_IMAGE=ghcr.io/dani-garcia/vaultwarden:latest
VAULTWARDEN_BIND_ADDRESS=127.0.0.1
VAULTWARDEN_PORT=8000

# Redis Configuration
REDIS_IMAGE=docker.io/redis:alpine
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_CONFIG_RENAME=VAULTWARDEN_CONFIG

# Security Settings
SIGNUPS_ALLOWED=false
SIGNUPS_VERIFY=true
INVITATIONS_ALLOWED=false

# Admin Token
ADMIN_TOKEN=$$argon2id

# Generate a strong ADMIN_TOKEN using:
# echo -n "your-secret-password" | argon2 "$(openssl rand -base64 16)" -id -t 3 -m 16 -p 4 -l 32
# ./edit-config.sh

# Logging
LOG_LEVEL=info
EXTENDED_LOGGING=false

# Database
DATABASE_MAX_CONNECTIONS=10
DATABASE_TIMEOUT=30
ENABLE_DB_WAL=true

# Rocket
ROCKET_WORKERS=4
ROCKET_KEEP_ALIVE=30

# Misc
WEBSOCKET_ENABLED=false
DISABLE_ICON_DOWNLOAD=false
IP_HEADER=X-Forwarded-For

# Network
VAULTWARDEN_NETWORK_INTERNAL=false