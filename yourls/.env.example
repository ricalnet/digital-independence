# YOURLS Configuration
YOURLS_IMAGE=docker.io/yourls:apache
YOURLS_BIND_ADDRESS=127.0.0.1
YOURLS_PORT=8001

# Site Configuration
YOURLS_SITE=https://yourls.domain.com
YOURLS_USER=admin
YOURLS_PASS=CHANGE_ME_YOURLS_PASS

# Cookie Key
YOURLS_COOKIEKEY=CHANGE_ME_YOURLS_COOKIEKEY

# Database Configuration
YOURLS_DB_USER=yourls
YOURLS_DB_PASS=CHANGE_ME_YOURLS_DB_PASS
YOURLS_DB_NAME=yourls
YOURLS_DB_PREFIX=yourls_

# MySQL Root Password
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_IMAGE=docker.io/mysql:8.0

# Security Settings
YOURLS_PRIVATE=true
YOURLS_HTTPS=true
YOURLS_UNIQUE_URLS=true
YOURLS_API_ENABLED=true
YOURLS_API_VERSION=v2
YOURLS_LANG=en
YOURLS_HOURS_OFFSET=7

# PHP Settings
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=30
PHP_MAX_INPUT_TIME=60
PHP_MAX_INPUT_VARS=1000
PHP_POST_MAX_SIZE=8M
PHP_UPLOAD_MAX_FILESIZE=2M

# MySQL Performance
MYSQL_INNODB_BUFFER_POOL_SIZE=64M
MYSQL_MAX_ALLOWED_PACKET=8M

# Network
YOURLS_NETWORK_INTERNAL=false