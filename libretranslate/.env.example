# LibreTranslate Configuration
LIBRETRANSLATE_IMAGE=docker.io/libretranslate/libretranslate:latest
LIBRETRANSLATE_BIND_ADDRESS=127.0.0.1
LIBRETRANSLATE_PORT=5001

# Load Only Languages
LT_LOAD_ONLY=en,id,ja,zh,es,fr,de

# Debug
LT_DEBUG=false

# Threads
LT_THREADS=4

# Update Models
LT_UPDATE_MODELS=false

# Request Limit
LT_REQ_LIMIT=60

# Server Workers
LT_SERVER_WORKERS=4

# SSL
LT_SSL=false

# API Keys
LT_API_KEYS=false

# Disable Web UI
LT_DISABLE_WEB_UI=false

# Disable File Translation
LT_DISABLE_FILES_TRANSLATION=false

# Character Limit
LT_CHAR_LIMIT=5000

# Frontend Language
LT_FRONTEND_LANGUAGE_SOURCE=en
LT_FRONTEND_LANGUAGE_TARGET=id

# Google Analytics
LT_GA_TRACKING=false

# Suggestions
LT_SUGGESTIONS=false

# Network
LIBRETRANSLATE_NETWORK_INTERNAL=false