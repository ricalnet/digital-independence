# Synapse Configuration
SYNAPSE_IMAGE=docker.io/matrixdotorg/synapse:latest
SYNAPSE_BIND_ADDRESS=127.0.0.1
SYNAPSE_PORT=8008
SYNAPSE_PORT_FEDERATION=8448

# Server Name
SYNAPSE_SERVER_NAME=matrix.domain.com

# Database Configuration
POSTGRES_USER=synapse
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=synapse
SYNAPSE_POSTGRES_USER=synapse
SYNAPSE_POSTGRES_PASSWORD=CHANGE_ME_SYNAPSE_POSTGRES_PASSWORD
SYNAPSE_POSTGRES_DB=synapse

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_CONFIG_RENAME=SYNAPSE_CONFIG

# PostgreSQL Performance
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAX_CONNECTIONS=100

# Logging
SYNAPSE_LOG_LEVEL=info

# Registration
SYNAPSE_ENABLE_REGISTRATION=false

# Images
SYNAPSE_POSTGRES_IMAGE=docker.io/postgres:18-alpine
REDIS_IMAGE=docker.io/redis:alpine