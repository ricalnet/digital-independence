# ============================================
# DOCKER IMAGES
# ============================================
# Change to a stable image (https://hub.docker.com/r/matrixdotorg/synapse)
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.105.0
SYNAPSE_POSTGRES_IMAGE=postgres:18-alpine

# ============================================
# SYNAPSE SERVER CONFIGURATION
# ============================================
# Your Matrix server domain (e.g., matrix.yourdomain.com)
# This MUST match your homeserver.yaml server_name
SYNAPSE_SERVER_NAME=your-domain.com

# Report anonymous usage statistics to Matrix.org
# Options: yes or no
SYNAPSE_REPORT_STATS=no

# Path to homeserver config inside container
SYNAPSE_CONFIG_PATH=/data/homeserver.yaml

# ============================================
# POSTGRESQL CONNECTION (for Synapse)
# ============================================
# PostgreSQL container hostname (should match container name)
SYNAPSE_POSTGRES_HOST=postgres

# Database credentials for Synapse
# Use strong, unique passwords!
SYNAPSE_POSTGRES_USER=synapse
SYNAPSE_POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
SYNAPSE_POSTGRES_DB=synapse

# ============================================
# POSTGRESQL DATABASE CONFIGURATION
# ============================================
# These are used by PostgreSQL container for initialization
# Must match the Synapse credentials above
POSTGRES_USER=synapse
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=synapse

# PostgreSQL initialization arguments
# These are optional but recommended for proper encoding
POSTGRES_INITDB_ARGS=--encoding=UTF8 --lc-collate=C --lc-ctype=C
