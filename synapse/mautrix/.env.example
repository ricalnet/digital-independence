# Mautrix Configuration
MAUTRIX_POSTGRES_IMAGE=docker.io/postgres:18-alpine
MAUTRIX_TELEGRAM_IMAGE=dock.mau.dev/mautrix/telegram:latest
MAUTRIX_WHATSAPP_IMAGE=dock.mau.dev/mautrix/whatsapp:latest

# Database Configuration
MAUTRIX_POSTGRES_DB=mautrix
MAUTRIX_POSTGRES_USER=mautrix
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# PostgreSQL Performance
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=256MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAX_CONNECTIONS=50

# Timezone
TZ=Asia/Jakarta 